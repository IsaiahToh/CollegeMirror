# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose "anthropic" or "gemini". Only the key for the chosen provider is needed.
LLM_PROVIDER=anthropic

# Anthropic / Claude (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Google / Gemini — free tier available (https://aistudio.google.com → Get API key)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# ── InDesign MCP ──────────────────────────────────────────────────────────────
# macOS only. Set ENABLED=true and point SERVER_PATH to the index.js of your
# indesign-mcp-server checkout. InDesign 2025 must be open when jobs run.
# When false, the XML fallback reader/writer is used (no InDesign required).
INDESIGN_MCP_ENABLED=true
INDESIGN_MCP_SERVER_PATH=/absolute/path/to/indesign-mcp-server/index.js

# ── Storage & server ──────────────────────────────────────────────────────────
STORAGE_PATH=./storage
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
